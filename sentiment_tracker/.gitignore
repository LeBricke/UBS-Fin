.env
.env.*
!.env.example

# Source documents (large binaries, likely copyrighted)
data/transcripts/*.pdf
data/transcripts/*.txt
!data/transcripts/.gitkeep

# Intermediate and final outputs (regenerated from the documents)
data/statements.csv
data/scored.csv
output/*.csv
output/*.png
output/*.md

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editors / OS
.DS_Store
.vscode/
.idea/
