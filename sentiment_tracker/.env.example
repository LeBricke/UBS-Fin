# Copy this file to `.env` and fill in your own values. Do NOT commit `.env`.

# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Reddit API credentials — create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=tag-capital-sentiment/0.1 by u/your_reddit_username
